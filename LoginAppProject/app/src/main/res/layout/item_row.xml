<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="8dp">

    <!-- left: uses the green/grey selector from res/color -->
    <CheckBox
        android:id="@+id/itemCheckBox_id"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:buttonTint="@color/checkbox_tint" />

    <!-- middle: pushes the trash button to the right -->
    <TextView
        android:id="@+id/itemNameText_id"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:text="Item name"
        android:textColor="#000000"
        android:textSize="22sp" />

    <!-- right: trash button -->
    <ImageButton
        android:id="@+id/deleteItemButton_id"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Delete item"
        android:src="@drawable/outline_delete_24"
        app:tint="#D32F2F" />

</LinearLayout>